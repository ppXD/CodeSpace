<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>codespace-runner-host</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodeSpace.Messages/CodeSpace.Messages.csproj" />
    <!-- Same permanent native launch thread as batch/stream; Linux PDEATHSIG follows the creating thread. -->
    <Compile Include="../CodeSpace.Core/Services/Agents/Sandbox/Runners/ProcessLaunchThread.cs" Link="ProcessLaunchThread.cs" />
  </ItemGroup>
</Project>

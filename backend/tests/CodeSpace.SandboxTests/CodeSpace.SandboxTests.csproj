<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>CodeSpace.SandboxTests.SandboxTestHost</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeSpace.Core\CodeSpace.Core.csproj" />
    <ProjectReference Include="..\..\src\CodeSpace.Messages\CodeSpace.Messages.csproj" />
    <!-- Build-only: McpHelperBindE2ETests and the broker relay E2E run the real codespace-mcp helper inside bwrap, and
         CopyMcpProxyToOutput below lands it where LocalProcessRunner.McpProxyBinaryPath() looks. Referenced the way the API
         references it — a standalone process, never linked. -->
    <ProjectReference Include="..\..\src\CodeSpace.Mcp\CodeSpace.Mcp.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Land the codespace-mcp helper next to the test assembly, at AppContext.BaseDirectory/codespace-mcp: the same place
       the API's publish lands it beside CodeSpace.Api.dll, so the sandbox sees the helper where production does. A
       ProjectReference does not carry the apphost and sidecars across on its own; fail loud on an empty glob, so no E2E
       can run against a helper that is not there. -->
  <Target Name="CopyMcpProxyToOutput" AfterTargets="Build">
    <PropertyGroup>
      <McpProxyOutDir>$(MSBuildThisFileDirectory)..\..\src\CodeSpace.Mcp\bin\$(Configuration)\$(TargetFramework)\</McpProxyOutDir>
    </PropertyGroup>
    <ItemGroup>
      <McpProxyFiles Include="$(McpProxyOutDir)codespace-mcp*" />
    </ItemGroup>
    <Error Condition="'@(McpProxyFiles)' == ''" Text="MCP helper build output not found under $(McpProxyOutDir) (glob codespace-mcp*) — codespace-mcp would be missing from $(OutDir), so the helper-bind and broker relay E2Es would have no helper to run. Check the build-only ProjectReference to CodeSpace.Mcp." />
    <Copy SourceFiles="@(McpProxyFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(McpProxyFiles)' != ''" />
  </Target>

</Project>
